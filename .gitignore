# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Raw data: too large for git, and redistributing Kaggle competition data is against its terms
data/raw/*
!data/raw/.gitkeep

# Processed data IS tracked: it's small (~200k row sample) and needs to be shared so all
# teammates get the exact same label-encoding / vocab sizes (see meta.json). Do not regenerate
# it with a different --nrows without re-syncing with the team, or vocab_sizes will mismatch.
data/processed/_train_undersampled.parquet   # runtime cache from strategy=undersample, regenerated on the fly

# Model checkpoints & logs
checkpoints/
*.pt
*.pth
runs/
logs/

# OS / editor
.DS_Store
.vscode/
.idea/
